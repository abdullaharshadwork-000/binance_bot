# -------------------------
# Trading mode
# -------------------------
# testnet = Binance Spot Testnet orders (development/validation target)
# live = real Binance Spot orders (explicit opt-in + validated protection required)
# paper remains only for legacy/offline tests; new trading features target exchange modes.
MODE=testnet
ALLOW_LIVE_TRADING=false
LIVE_PROTECTION_VALIDATED=false
# SYMBOL/BASE_ASSET keep backwards-compatible single-symbol mode.
SYMBOL=BTCUSDT
BASE_ASSET=BTC
QUOTE_ASSET=USDT

# Discover a bounded Spot universe ranked by rolling 24-hour quote volume.
# The engine trades only the top eligible markets plus manual pins and markets
# retained for open-position/order recovery. This liquidity screen is not a promise
# of profit. Common stablecoin and leveraged-token bases are excluded.
UNIVERSE_MODE=top_volume
UNIVERSE_MAX_SYMBOLS=15
UNIVERSE_MIN_QUOTE_VOLUME=1000000
UNIVERSE_REFRESH_MINUTES=60
UNIVERSE_PINNED_SYMBOLS=
UNIVERSE_EXCLUDED_BASES=USDC,BUSD,FDUSD,TUSD,USDP,DAI,USDE,USDD,USD1

# Optional manual inclusions; leave blank to rely on dynamic discovery.
# All markets must share QUOTE_ASSET.
SYMBOLS=
MAX_CONCURRENT_POSITIONS=2
MAX_PORTFOLIO_EXPOSURE_FRACTION=0.15
ACCOUNT_MAX_AGE_SECONDS=15
MAX_ENTRY_DEVIATION_PCT=0.015
ENTRY_COOLDOWN_SECONDS=60
ENTRY_RETRY_SECONDS=30

# Multi-symbol live mode has a separate safety opt-in and should remain false
# until the multi-symbol engine has been validated thoroughly in Testnet.
ALLOW_MULTI_SYMBOL_LIVE=false

# Strategy timeframe. The strategy recalculates only on COMPLETED candles.
INTERVAL=15m

# Fast market/risk monitor. 1 = check stop loss / take profit every second.
CYCLE_SECONDS=1
USE_WEBSOCKET_MARKET_DATA=true
MARKET_DATA_STALE_SECONDS=3
STRATEGY_REFRESH_GRACE_SECONDS=1

# In testnet/live, account balances do not need to be queried every second.
ACCOUNT_REFRESH_SECONDS=5

# -------------------------
# Binance credentials
# Never commit real secrets.
# Testnet/live require credentials. Use Testnet keys during development.
# -------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# -------------------------
# Risk controls
# -------------------------
PAPER_STARTING_BALANCE=1000
RISK_PER_TRADE=0.0025
MAX_POSITION_FRACTION=0.05
MAX_DAILY_LOSS_FRACTION=0.01
STOP_LOSS_PCT=0.012
TAKE_PROFIT_PCT=0.024
# Volatility-adaptive protection: scale stop/target distances from the signal
# candle ATR instead of fixed percentages. Distances stay clamped between
# ATR_STOP_MIN_PCT/ATR_STOP_MAX_PCT and preserve the configured reward:risk
# ratio. Set false to always use the fixed percentages above.
USE_ATR_STOPS=true
ATR_STOP_MULTIPLIER=2.0
ATR_STOP_MIN_PCT=0.006
ATR_STOP_MAX_PCT=0.05
# Lock in gains as a position advances. The stop only ever moves upward.
ENABLE_TRAILING_STOP=true
BREAKEVEN_ACTIVATION_PCT=0.006
TRAILING_STOP_ACTIVATION_PCT=0.01
TRAILING_STOP_DISTANCE_PCT=0.008
MIN_SIGNAL_CONFIDENCE=0.70
TRADING_FEE_BPS=10

# Legacy paper-mode setting; exchange-mode execution uses real Binance fills.
PAPER_SLIPPAGE_BPS=2

# -------------------------
# Adaptive learning
# Automatically active in testnet; live adaptive changes require separate opt-in.
# Live adaptive changes require separate opt-in.
# -------------------------
ENABLE_ADAPTIVE_LEARNING=true
ALLOW_ADAPTIVE_LIVE=false
MIN_TRADES_FOR_LEARNING=50

# -------------------------
# Optional LLM market advisor
# The LLM cannot place orders; it may only nudge confidence slightly.
# -------------------------
ENABLE_LLM_ADVISOR=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# -------------------------
# Storage
# -------------------------
DATABASE_PATH=data/trading_bot.db
LEARNING_PROFILE_PATH=data/learning_profile.json

# Entry quality filters (validate in Testnet before live use).
STRATEGY_MIN_VOLUME_RATIO=0.75
STRATEGY_MAX_EXTENSION_ATR=2.0

# Reject barely separated EMA crossovers; pause new entries after a loss streak.
STRATEGY_MIN_TREND_ATR=0.25
STRATEGY_MIN_ADX=16
MAX_CONSECUTIVE_LOSSES=3
LOSS_STREAK_PAUSE_SECONDS=3600

# Non-paper entry checks against visible book depth (not guaranteed fill prices).
MAX_ENTRY_SPREAD_BPS=20
MAX_ENTRY_SLIPPAGE_BPS=25

# -------------------------
# Observability
# -------------------------
# Console logging verbosity for the engine (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
